{
  "welcomeFile": "/",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/$",
      "target": "/health",
      "destination": "backend",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/api/(.*)$",
      "target": "/$1",
      "destination": "backend",
      "authenticationType": "xsuaa",
      "scope": "$XSAPPNAME.Read"
    },
    {
      "source": "^/health$",
      "target": "/health",
      "destination": "backend",
      "authenticationType": "none"
    }
  ]
}
