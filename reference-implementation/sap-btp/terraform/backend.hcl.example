bucket                      = "<terraform-state-bucket>"
key                         = "sap-btp/platform-probe.tfstate"
region                      = "main"
endpoints                   = { s3 = "<s3-compatible-state-endpoint>" }
profile                     = "portfolio-lab"
skip_credentials_validation = true
